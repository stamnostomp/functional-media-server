cabal-version:      3.0
name:               functional-media-server
version:            0.1.0.0
synopsis:           A Jellyfin-like media server written in Haskell
description:
  A media server inspired by Jellyfin, implemented in Haskell and
  built with Nix via cabal2nix. See docs/index.org for the project hub.
license:            MIT
author:             stamnostomp
maintainer:         stamno@stamno.com
category:           Network
build-type:         Simple

common shared
    default-language: Haskell2010
    default-extensions: OverloadedStrings
                      , LambdaCase
                      , ScopedTypeVariables
                      , DerivingStrategies
                      , GeneralizedNewtypeDeriving
    ghc-options:      -Wall -Wcompat

library
    import:           shared
    hs-source-dirs:   src
    exposed-modules:  FMS
                      FMS.Server
                      FMS.Core.Blurhash
                      FMS.Core.Monad
                      FMS.Core.Module
                      FMS.Core.Router
                      FMS.Core.Query
                      FMS.Core.Range
                      FMS.Core.RateLimit
                      FMS.Core.Process
                      FMS.Core.Cli
                      FMS.Core.Types.Config
                      FMS.Core.Types.MediaFolder
                      FMS.Core.Types.Log
                      FMS.Core.Types.MediaItem
                      FMS.Core.Types.Policy
                      FMS.Core.Types.Progress
                      FMS.Core.Types.ServerConfig
                      FMS.Core.Types.User
                      FMS.Modules.System
                      FMS.Modules.Auth
                      FMS.Modules.Auth.Monad
                      FMS.Modules.Auth.State
                      FMS.Modules.Auth.Routes
                      FMS.Modules.Stream
                      FMS.Modules.Transcode
                      FMS.Modules.Dash
                      FMS.Modules.Hls
                      FMS.Modules.Subtitles
                      FMS.Modules.Chapters
                      FMS.Modules.Thumbs
                      FMS.Modules.Images
                      FMS.Modules.Stats
                      FMS.Modules.Stats.Monad
                      FMS.Modules.Stats.Persistence
                      FMS.Modules.Stats.Routes
                      FMS.Modules.UserData
                      FMS.Modules.UserData.Types
                      FMS.Modules.UserData.Persistence
                      FMS.Modules.UserData.Monad
                      FMS.Modules.UserData.Routes
                      FMS.Modules.Metadata
                      FMS.Modules.Metadata.Api.Types
                      FMS.Modules.Metadata.Api.Tmdb
                      FMS.Modules.Metadata.Types
                      FMS.Modules.Metadata.Nfo
                      FMS.Modules.Metadata.Persistence
                      FMS.Modules.Metadata.Monad
                      FMS.Modules.Metadata.Routes
                      FMS.Modules.Library
                      FMS.Modules.Library.Monad
                      FMS.Modules.Library.Watch
                      FMS.Modules.Library.Routes
                      FMS.Modules.Library.Scan
                      FMS.Modules.Library.State
                      FMS.Modules.Library.Folders
                      FMS.Modules.Playback
                      FMS.Modules.Playback.Types
                      FMS.Modules.Playback.Probe
                      FMS.Modules.Playback.Routes
                      FMS.Modules.Playlists
                      FMS.Modules.Playlists.Types
                      FMS.Modules.Playlists.Persistence
                      FMS.Modules.Playlists.Monad
                      FMS.Modules.Playlists.Routes
                      FMS.Modules.Collections
                      FMS.Modules.Collections.Types
                      FMS.Modules.Collections.Persistence
                      FMS.Modules.Collections.Monad
                      FMS.Modules.Collections.Routes
                      FMS.Modules.Segments
                      FMS.Modules.Segments.Types
                      FMS.Modules.Segments.Persistence
                      FMS.Modules.Segments.Monad
                      FMS.Modules.Segments.Routes
                      FMS.Modules.Devices
                      FMS.Modules.Devices.Types
                      FMS.Modules.Devices.Persistence
                      FMS.Modules.Devices.Monad
                      FMS.Modules.Devices.Routes
                      FMS.Modules.Webhooks
                      FMS.Modules.Webhooks.Types
                      FMS.Modules.Webhooks.Persistence
                      FMS.Modules.Webhooks.Monad
                      FMS.Modules.Webhooks.Routes
                      FMS.Modules.Sessions
                      FMS.Modules.Sessions.Types
                      FMS.Modules.Sessions.Monad
                      FMS.Modules.Sessions.Routes
                      FMS.Modules.Socket
                      FMS.Modules.Admin
                      FMS.Modules.Admin.Types
                      FMS.Modules.Admin.Monad
                      FMS.Modules.Admin.Tasks
                      FMS.Modules.Admin.Scheduler
                      FMS.Modules.Admin.Routes
                      FMS.Modules.Web
                      FMS.Modules.ApiDocs
    build-depends:    base >=4.14 && <5
                    , mtl
                    , transformers
                    , text
                    , bytestring
                    , containers
                    , unordered-containers
                    , directory
                    , filepath
                    , time
                    , stm
                    , template-haskell
                    , aeson
                    , acid-state
                    , safecopy
                    , wai
                    , warp
                    , warp-tls
                    , websockets
                    , wai-websockets
                    , network
                    , http-types
                    , http-conduit
                    , http-client
                    , http-client-tls
                    , case-insensitive
                    , xml-conduit
                    , process
                    , bcrypt
                    , random

    if os(linux)
      build-depends:  hinotify
      cpp-options:    -DFMS_LINUX

test-suite fms-test
    import:           shared
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    build-depends:    base >=4.14 && <5
                    , bytestring
                    , text
                    , containers
                    , unordered-containers
                    , directory
                    , filepath
                    , time
                    , acid-state
                    , safecopy
                    , cereal
                    , process
                    , unix
                    , aeson
                    , functional-media-server

executable fms
    import:           shared
    hs-source-dirs:   app
    main-is:          Main.hs
    build-depends:    base >=4.14 && <5
                    , text
                    , directory
                    , functional-media-server
